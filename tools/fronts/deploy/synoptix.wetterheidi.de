# nginx-Vhost für synoptix.wetterheidi.de (Frontenanalyse), Schutz über den
# Pförtner (Tool "synoptix"). Wird von deploy-synoptix.sh nach
# /etc/nginx/sites-available/ kopiert; das Zertifikat holt die Ersteinrichtung
# mit "certbot certonly --nginx" (die Datei hier wird von certbot nicht verändert).
server {
    server_name synoptix.wetterheidi.de;
    root /apps/synoptix/app;

    # --- Pfoertner ---
    set $pfoertner_tool synoptix;
    auth_request /_pfoertner;
    error_page 401 = @zum_login;
    error_page 403 /gesperrt.html;
    include snippets/pfoertner.conf;

    # Index, Metadaten und Module komprimiert ausliefern (die Felder liegen
    # schon als .json.gz vor und werden von der Seite selbst entpackt).
    gzip_types application/json application/javascript text/css;

    # Bis zur eigenen App (Phase 3) ist die Debug-Seite die Startseite.
    location = / {
        return 302 /tools/fronts/debug.html;
    }

    # Archiv der laufenden Analyse (run-analysis.mjs --out /apps/synoptix/data),
    # dort, wo die Debug-Seite es sucht (live/ neben der Seite). Nicht cachen:
    # latest.json, index.json und vorläufige Termine ändern sich.
    location /tools/fronts/live/ {
        alias /apps/synoptix/data/;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/synoptix.wetterheidi.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/synoptix.wetterheidi.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name synoptix.wetterheidi.de;
    return 301 https://$host$request_uri;
}
