# Laufende Frontenanalyse für synoptix.wetterheidi.de (s. tools/fronts/README.md,
# „Laufende Analyse“). Wird vom Timer gleichen Namens gestartet; von Hand:
#   systemctl start synoptix-analysis      (Ausgabe: journalctl -u synoptix-analysis)
[Unit]
Description=synoptix: laufende Frontenanalyse (meteokit run-analysis.mjs)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/apps/synoptix/app
ExecStart=/usr/bin/node tools/fronts/run-analysis.mjs --out /apps/synoptix/data
# Der Server hat 2 Kerne, kein Swap und weitere speicherhungrige Dienste.
# Gemessen 13.10.: Spitze 176–215 MB, rund 4 CPU-Minuten je Termin. Reißt der Job
# die Grenze, beendet der Kernel nur ihn, nicht WindScope o. ä.; mit Nice
# weicht er laufenden Downloads (TLogPViewer) aus, statt sie auszubremsen.
MemoryMax=350M
MemorySwapMax=0
Nice=10
TimeoutStartSec=2h
